# Elysium testnet (chain 99801) — https://elysium.kinetiq.xyz/docs/connecting-to-elysium
NEXT_PUBLIC_ELYSIUM_TESTNET_RPC=https://testnet-rpc.elysium.kinetiq.xyz
NEXT_PUBLIC_ELYSIUM_TESTNET_EXPLORER=https://elysium.kinetiq.xyz/testnet-explorer
NEXT_PUBLIC_ESCROW_99801=

# Elysium mainnet (chain 99901) — public release only
NEXT_PUBLIC_ELYSIUM_RPC=
NEXT_PUBLIC_ELYSIUM_EXPLORER=
NEXT_PUBLIC_ESCROW_99901=

# HyperEVM testnet (chain 998) — interim staging until Elysium testnet is live
NEXT_PUBLIC_HYPEREVM_TESTNET_RPC=https://rpc.hyperliquid-testnet.xyz/evm
# No verified explorer yet; tx hashes are shown without links when empty
NEXT_PUBLIC_HYPEREVM_TESTNET_EXPLORER=
NEXT_PUBLIC_ESCROW_998=

# Optional: WalletConnect (mobile wallets). Injected wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=

# Local development against anvil (chain 31337)
NEXT_PUBLIC_ENABLE_LOCAL=0
NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545
NEXT_PUBLIC_ESCROW_31337=
# Dev only: auto-connect a mock wallet bound to an unlocked anvil account
# NEXT_PUBLIC_MOCK_ACCOUNT=
